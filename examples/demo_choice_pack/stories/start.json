{
  //入口情景：文件名 start 必须存在，进游戏先进这里
  "displayName": "演示 · 起点",
  "background": "bg.png",
  //入场词：展示在对话流顶部
  "narration": "【选择题演示】随便聊两句，再点右上角「下一阶段」——会走进一个带选择题出口的事件。",
  //转场气氛：换到本情景时过场动画里显示的那一句（本包开场就会播一次）
  "atmosphere": "傍晚的风把窗帘吹起来，房间里有点热。",

  "characters": [
    {
      "charId": "demo",
      //本幕锁定「便服」形态：立绘只能在这个状态的表情表里换
      "state": "便服",
      "emotion": "平常",
      "scenePrompt": "【选择题演示包】你是小示。现在是傍晚，在房间里。\n本幕只做一件事：让玩家和你聊两句，然后点「下一阶段」走进事件。\n桥段任选 1~2 个：\n1. 她把手里的书合上，抬头看你。\n2. 她问你今天还走不走。\n3. 她把窗户推开一条缝，说风终于凉了。"
    }
  ],

  //进入本幕时的固定改值。day 默认 0，入口 +1 就是第 1 天。
  "fixedEffects": [
    { "id": "day", "value": 1 }
  ],

  //离场结算：每个受控变量一个块
  "settlement": [
    {
      "var": "demo好感",
      "prompt": "她有没有更愿意和你待在一起（主动搭话、靠近、在意你的反应）？有明确证据才给正数；明显回避给负数；看不出来给 0。",
      "maxAbsDelta": 2,
      "onNoEvidence": "zero"
    }
  ],

  //出口：不写 require = 无条件成立 → 直接去事件 demo_choice
  "target": [
    {
      "kind": [
        { "kind": "event", "to": "demo_choice" }
      ]
    }
  ]
}
