{
  //入口情景：文件名 start 必须存在。进游戏先进这里。
  "displayName": "白天·上学",
  "background": "xx_q.png",
  "narration": "早上到了学校。新的一天，从这里开始。",
  "atmosphere": "教室窗外蝉鸣，又是普通的一天。",
  "characters": [
    {
      "charId": "戒戒",
      //本幕锁定「校服猫化」形态：立绘只能在这个状态的表情表里换
      "state": "校服猫化",
      "emotion": "平常",
      //场景提示词：给模型的「这一幕怎么演」；教学说明写在注释里，不要进 prompt
      "scenePrompt": "你是戒戒，半人半猫（猫耳和尾巴），现在是白天、学校。态度可以平常一点，话不多，偶尔偷偷看你。\n桥段可以挑一两个自然带出来：\n1. 课间她趴在桌上装睡，猫耳却跟着你的脚步转。\n2. 她把橡皮切成两半，分你一半。\n3. 操场有野猫，她盯着看了很久。"
    }
  ],

  //进入本幕时的固定改值。白天是新一天的开始，所以 day+1 写在这里：
  //开新游戏时 manifest 的 day 默认 0，进场 +1 就是第 1 天；
  //之后每次从「晚上·家里」回到这里，天数再加一。
  "fixedEffects": [
    { "id": "day", "value": 1 }
  ],

  //离场结算：只示范一个变量。maxAbsDelta = 单次最多加减；onNoEvidence = 没证据时保持 0
  "settlement": [
    {
      "var": "戒戒好感",
      "prompt": "她是不是更愿意和你待在一起了？有具体举动才加分；明显冷淡就扣分；看不出来就是 0。",
      "maxAbsDelta": 2,
      "onNoEvidence": "zero"
    }
  ],

  //出口：自上而下找第一个 require 成立的块。这里故意不写 require = 无条件成立。
  //块内 kind 数组只有一个目标 → 直接去「下午·外面」。
  //写多个 kind 时会在块内等概率随机（本包为了教学只放一个）。
  "target": [
    {
      "kind": [
        { "kind": "story", "to": "day_afternoon" }
      ]
    }
  ]
}
