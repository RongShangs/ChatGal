{
  //情景展示名（左上角显示「第N天 · 展示名」）
  "displayName": "白天·学校",
  //背景图：stories/ 下的文件名，请确保存在
  "background": "xx_q.png",
  //入场词：会展示在对话流顶部
  "narration": "【异常初现】上课时，戒戒突然不适地揉了揉眼睛。哥哥转头看她时，发现她的瞳孔在日光灯下闪过一瞬琥珀色的光泽，随即恢复深棕。戒戒困惑地眨了眨眼，似乎自己也没察觉异样，低头继续看书。",
  //转场气氛：换到本情景时过场动画里显示的那一句（可选）
  "atmosphere": "上课铃在走廊荡开，教室渐渐坐满。",
  //角色控制：scenePrompt 是本情景的额外提示词，把地点/时间/当下情境直接写清楚
  "characters": [
    {
      "charId": "戒戒",
      "state": "校服",
      "emotion": "平常",
      "scenePrompt": "你是已成年的戒戒（不是未成年），身高 158cm，刚跟着哥哥转学到这座陌生的城市。他是你哥，可好几年没见了，跟陌生人差不多。你本来就不爱说话，更不知道该怎么面对这个突然插进生活里的家人。\n你觉得自己目前就是个普通女孩。剧情里身体是否出现异常，完全以当前这一幕的提示为准；提示没写到时，不要抢跑描述猫耳、竖瞳或已经发生的异变。\n只在哥哥面前，你偶尔会漏出一点不安——毕竟，他是这里唯一和你有点关系的人。现在是第 2 天的白天，地点在学校。这一幕讲的是【异常初现】：课堂上她的瞳孔闪过一瞬琥珀色又立刻复原，她本人毫无察觉，本幕把「异变第一次露头」放在你的眼睛里。就按这一幕走，后面几天的事先别提。她现在是普通成年女孩的样子，没有猫耳、尾巴，也没有明显异变；不要写已经出现的猫化外观或「身体正在异变」当既定事实（本幕正文若只写极细微的疑惑，也只当作她的困惑，不要写成已确诊）。你们几乎不认识：她戒备，话极少，不会先开口。"
    }
  ],

  //进入本情景时变化的值：正数为加、负数为减
  //新的一天的第一个时段这样写：{ "id": "day", "value": 1 }（day 加 1）；其余情景写空数组
  //day 默认是 0，所以第 1 天也靠这条改值得到：start 里同样写 day +1
  "fixedEffects": [
    {
      "id": "day",
      "value": 1
    }
  ],

  //离场结算：**每个受控变量一个块**：var = 变量 id，prompt = 这个变量单独怎么判，
  //maxAbsDelta = 这一个变量单次最多加减多少（整数），onNoEvidence = 拿不到证据时 zero 保持原值 / abort 拒绝本次离场
  //块里的 var 必须是上面注册过的数值变量；不写整个 settlement 数组 = 本幕不结算
  "settlement": [
    {
      "var": "戒戒好感",
      "prompt": "她这幕是不是更愿意靠近你、搭理你了？有具体举动才加分（主动搭话、凑近、在意你的反应）；躲着你、明显冷下来就扣分；看不出来就是 0。",
      "maxAbsDelta": 3,
      "onNoEvidence": "zero"
    },
    {
      "var": "戒戒信任",
      "prompt": "她是不是更敢把事情交给你了？比如开口求助、说实话、把东西托付给你。有具体举动才加分；明显更防备就扣分；看不出来就是 0。",
      "maxAbsDelta": 3,
      "onNoEvidence": "zero"
    },
    {
      "var": "戒戒服从",
      "prompt": "她有没有照你说的做、把自己的主意放下来？有具体举动才加分；跟你对着来就扣分；看不出来就是 0。",
      "maxAbsDelta": 3,
      "onNoEvidence": "zero"
    },
    {
      "var": "戒戒堕落",
      "prompt": "这幕里有没有越过界的占有、支配或身体接触，而她接受了？只有明确发生了才加分；她明确抗拒就扣分；看不出来就是 0。",
      "maxAbsDelta": 3,
      "onNoEvidence": "zero"
    }
  ],

  //离开判断：自上而下依次轮询，首个 require 成立的块被锁定；块内多个 kind 等概率
  //没有满足的块（或压根没有 target）时本情景没有出口，点「下一阶段」会提示「暂时不能进入下一阶段噢」
  //require 是中缀表达式：变量名一律加双引号，如 "day" == 7 & "戒戒好感" < 60；算子 > < >= <= == != & | ! ( ) + -；不写 require 的块无条件成立（当保底用，写在最后）
  //day 读的是离开前的天数（本幕所属那一天），其它变量读结算后的值
  "target": [
    {
      "kind": [
        {
          "kind": "story",
          "to": "day2_2"
        }
      ]
    }
  ]
}
