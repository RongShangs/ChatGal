{
  //事件不要 id 与 name：世界控制台里显示的就是本事件所在文件夹名
  //点击依次播放：一块 = 一张图 + 若干句；句播完换下一块
  //image 写相对本事件目录的文件名；写 null 表示沿用上一张图
  "slides": [
    {
      "image": "cover.png",
      "text": [
        "第十四天的夜里，你们站在地下实验室那管试剂前。"
      ]
    },
    {
      "image": null,
      "text": [
        "她把尖长而颤抖的手放进你的手心，像把命交出来一样。"
      ]
    },
    {
      "image": null,
      "text": [
        "注射：变回普通人类。猫耳与尾巴会消失，这十四天的记忆——连同刚想起的真相——也会一并被抹掉。"
      ]
    },
    {
      "image": null,
      "text": [
        "不注射：继续共生。记忆还在，人也还在，但身体不会立刻变好，靠你维系的日子还要过下去。"
      ]
    },
    {
      "image": null,
      "text": [
        "「准备好了吗？」"
      ]
    }
  ],
  //选择题出口（事件专有，与 target 二选一）：播完最后一屏后，玩家在这几个选项里选一个
  //title 是问题上方的标题（可留空）；options 最多 5 个，每项 text 是按钮上的字、kind/to 是去哪
  //选项不判断数值、也不随机：玩家点哪个就去哪个（kind 可以写 story / event / appShell）
  "choice": {
    "title": "打不打针？",
    "options": [
      {
        "text": "注射毛至试剂",
        "kind": "event",
        "to": "end_csrj"
      },
      {
        "text": "不注射，继续共生",
        "kind": "event",
        "to": "end_no_inject"
      }
    ]
  }
}
